rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Şifre koleksiyonları: TAMAMEN KİLİTLİ ──
    // Okuma ve yazma sadece Cloud Functions (Admin SDK) üzerinden yapılır
    match /passwords/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Duyurular: herkes okuyabilir, yazma kapalı ──
    match /duyurular/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Öğrenci verileri: giriş yapmış kullanıcılar okuyabilir ──
    match /students/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'name', 'surname', 'studentNo', 'department', 'email', 'phone',
          'country', 'university', 'status', 'notes', 'updatedAt', 'createdAt',
          'documents', 'applicationDate', 'period', 'erasmusType'
        ]);
    }

    // ── Akademisyen verileri ──
    match /professors/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'name', 'surname', 'department', 'email', 'phone', 'title',
          'country', 'university', 'status', 'notes', 'updatedAt', 'createdAt'
        ]);
    }

    // ── Anlaşmalar: giriş yapmış kullanıcılar ──
    match /agreements/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Kullanıcı rolleri ──
    match /user_roles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Ayarlar: sadece okuma ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Sınavlar: giriş yapmış kullanıcılar ──
    match /exams/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Proje dersleri: giriş yapmış kullanıcılar ──
    match /project_courses/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Projeler: giriş yapmış kullanıcılar ──
    match /projects/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Diğer tüm koleksiyonlar: giriş yapmış kullanıcılar okuyabilir ──
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
