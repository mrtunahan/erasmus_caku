rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Şifre koleksiyonları: TAMAMEN KİLİTLİ ──
    // Okuma ve yazma sadece Cloud Functions (Admin SDK) üzerinden yapılır
    match /passwords/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Duyurular: herkes okuyabilir, yazma kapalı ──
    match /duyurular/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Öğrenci verileri: herkes okuyabilir, yazma giriş gerektirir ──
    match /students/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Akademisyen verileri ──
    match /professors/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Anlaşmalar: giriş yapmış kullanıcılar ──
    match /agreements/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Kullanıcı rolleri ──
    match /user_roles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Ayarlar: sadece okuma ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Sınavlar: giriş yapmış kullanıcılar ──
    match /exams/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Sınav sonuçları: giriş yapmış kullanıcılar ──
    match /exam_results/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Sınav dönemleri: giriş yapmış kullanıcılar ──
    match /exam_periods/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Proje dersleri: giriş yapmış kullanıcılar ──
    match /project_courses/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Projeler: giriş yapmış kullanıcılar ──
    match /projects/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Ders grupları: giriş yapmış kullanıcılar ──
    match /course_groups/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Ders grubu paylaşımları: giriş yapmış kullanıcılar ──
    match /course_group_posts/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Anketler: giriş yapmış kullanıcılar ──
    match /surveys/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Etkinlikler: giriş yapmış kullanıcılar ──
    match /events/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Kaynaklar: giriş yapmış kullanıcılar ──
    match /resources/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Formlar: giriş yapmış kullanıcılar ──
    match /forms/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Eşleştirme geçmişi: giriş yapmış kullanıcılar ──
    match /trip_history/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Diğer tüm koleksiyonlar: giriş yapmış kullanıcılar okuyabilir ──
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
