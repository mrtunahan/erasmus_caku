rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Passwords - sadece authenticated kullanıcılar erişebilir
    match /passwords/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Students - giriş doğrulaması için okuma açık, yazma auth gerektirir
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Professors - giriş dropdown'u için okuma açık, yazma auth gerektirir
    match /professors/{profId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User rolleri ve profilleri - sadece kendi verisini yazabilir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Diğer tüm koleksiyonlar - authentication gerektirir
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
