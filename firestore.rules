rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Şifre koleksiyonları: TAMAMEN KİLİTLİ ──
    // Okuma ve yazma sadece Cloud Functions (Admin SDK) üzerinden yapılır
    match /passwords/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Duyurular: herkes okuyabilir, yazma kapalı ──
    match /duyurular/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Öğrenci verileri ──
    match /students/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Akademisyen verileri ──
    match /professors/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Kullanıcı rolleri ──
    match /users/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Ayarlar: sadece okuma ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Anlaşmalar ──
    match /agreements/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sınavlar ──
    match /exams/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sınav sonuçları ──
    match /exam_results/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sınav dönemleri ──
    match /exam_periods/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sınav otomasyonu: program ──
    match /sinav_programi/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sınav otomasyonu: dersler ──
    match /sinav_dersler/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sınav otomasyonu: dönemler ──
    match /sinav_donemler/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Öğrenci portalı: gönderiler ──
    match /portal_posts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Öğrenci portalı: yorumlar ──
    match /portal_comments/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Proje dersleri ──
    match /project_courses/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Projeler ──
    match /projects/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Ders grupları ──
    match /course_groups/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Ders grubu paylaşımları ──
    match /course_group_posts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Anketler ──
    match /surveys/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Etkinlikler ──
    match /events/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Kaynaklar ──
    match /resources/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Formlar ──
    match /forms/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Eşleştirme geçmişi ──
    match /trip_history/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Diğer tüm koleksiyonlar: okuma açık, yazma kapalı ──
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
