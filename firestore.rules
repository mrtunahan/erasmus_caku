rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Passwords - geçiş döneminde okuma açık (migration), yazma auth gerektirir
    // NOT: Tüm kullanıcılar Firebase Auth'a geçtikten sonra read: if request.auth != null yapın
    match /passwords/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Students - giriş doğrulaması için okuma açık, yazma auth gerektirir
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Professors - giriş dropdown'u için okuma açık, yazma auth gerektirir
    match /professors/{profId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User rolleri ve profilleri
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Diğer tüm koleksiyonlar - authentication gerektirir
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
