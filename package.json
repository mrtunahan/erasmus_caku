{
  "name": "erasmus_caku",
  "version": "1.0.0",
  "description": "Çankırı Karatekin Üniversitesi için geliştirilmiş Erasmus öğrenci ders eşleştirme ve yönetim sistemi.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "lint": "eslint . --ext .js,.jsx,.cjs",
    "lint:fix": "eslint . --ext .js,.jsx,.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true vite build",
    "prepare": "husky 2>/dev/null || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrtunahan/erasmus_caku.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.13.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 9999"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "lucide-react": "^1.16.0",
    "quill": "^2.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io-client": "^4.8.3"
  }
}
