# MongoDB bağlantı URI'si (zorunlu)
MONGODB_URI=mongodb://127.0.0.1:27017/erasmus_caku

# Sunucu portu (varsayılan: 3001)
PORT=3001

# JWT gizli anahtarı — ÜRETİMDE ZORUNLU
# Bu örnek değeri OLDUĞU GİBİ KULLANMAYIN. Aşağıdaki komutla güçlü bir değer üretin:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Not: production'da bilinen dev-fallback değeri reddedilir (sunucu açılmaz).
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX

# JWT token süresi (varsayılan: 24h)
JWT_EXPIRES_IN=24h

# Node ortamı (production/development)
NODE_ENV=development

# CORS — izin verilen origin'ler (virgüllü liste).
# Boş bırakılırsa request origin'i yansıtılır (eski davranış).
# Üretim örneği: ALLOWED_ORIGINS=https://erasmus.karatekin.edu.tr,https://www.karatekin.edu.tr
ALLOWED_ORIGINS=

# Logger seviyesi: trace|debug|info|warn|error|fatal (varsayılan: prod=info, dev=debug)
LOG_LEVEL=

# Sentry — boş bırakılırsa devre dışı
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
