# MongoDB bağlantı URI'si (zorunlu)
MONGODB_URI=mongodb://127.0.0.1:27017/erasmus_caku

# Sunucu portu (varsayılan: 3001)
PORT=3001

# JWT gizli anahtarı — ÜRETİMDE ZORUNLU
# Bu örnek değeri OLDUĞU GİBİ KULLANMAYIN. Aşağıdaki komutla güçlü bir değer üretin:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Not: production'da bilinen dev-fallback değeri reddedilir (sunucu açılmaz).
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX

# JWT token süresi (varsayılan: 24h)
JWT_EXPIRES_IN=24h

# Node ortamı (production/development)
NODE_ENV=development

# CORS — izin verilen origin'ler (virgüllü liste).
# Boş bırakılırsa request origin'i yansıtılır (eski davranış).
# Üretim örneği: ALLOWED_ORIGINS=https://erasmus.karatekin.edu.tr,https://www.karatekin.edu.tr
ALLOWED_ORIGINS=

# ── Erişim kontrolü (RBAC) ──
# /api/db erişim politikası: 'enforce' (varsayılan) — okuma/yazma için token
# ve rol denetimi yapılır. Acil geri dönüş için 'off' (ESKİ AÇIK DAVRANIŞ —
# yalnızca sorun gidermek için geçici kullanın).
DB_AUTH_MODE=enforce

# CSRF koruması: varsayılan ENFORCE (Origin/Referer eşleşmeyen cookie-tabanlı
# yazmalar 403). Bearer token'lı istekler muaftır. Gevşetmek için: soft
CSRF_PROTECTION=enforce

# Logger seviyesi: trace|debug|info|warn|error|fatal (varsayılan: prod=info, dev=debug)
LOG_LEVEL=

# Sentry — boş bırakılırsa devre dışı
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ── AI (akreditasyon ÖDR taslak yazımı) — model-agnostik ──
# Sağlayıcı: aşağıdaki anahtarlardan HANGİSİ tanımlıysa o kullanılır.
# İsterseniz AI_PROVIDER ile açıkça seçin: anthropic | openai | gemini
AI_PROVIDER=
# Sağlayıcı API anahtarları (yalnız kullanacağınızı doldurun):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model (opsiyonel — boşsa sağlayıcıya göre makul varsayılan:
#   anthropic=claude-3-5-haiku-latest, openai=gpt-4o-mini, gemini=gemini-1.5-flash)
AI_MODEL=

# ── Belge işleme (form doldurma / dosya eşleştirme / web doğrulama) ──
# Bu katman model-agnostik DEĞİLDİR: yalnız claude-haiku-4-5-20251001 ile
# çalışır ve tek anahtar kullanır → ANTHROPIC_API_KEY (yukarıda).
# Model kimliği kod içinde sabittir (server/services/claude-extract.js);
# AI_MODEL bu uçları ETKİLEMEZ — yalnız ÖDR taslağını etkiler.
#
# Anahtar tanımlı değilse /api/ai/extract ve /api/ai/verify 503 döner;
# uygulamanın geri kalanı normal çalışır.
